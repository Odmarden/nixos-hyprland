[global]
    font = JetBrainsMono Nerd Font 10
    frame_width = 2
    frame_color = "#7aa2f7"
    corner_radius = 10
    transparency = 10
    background = "#1a1b26"
    foreground = "#c0caf5"

[urgency_low]
    background = "#1a1b26"
    foreground = "#a9b1d6"
    frame_color = "#414868"
    timeout = 4

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    timeout = 6

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0
